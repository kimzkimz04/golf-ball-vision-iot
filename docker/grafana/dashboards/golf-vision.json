    {
      "id": 5,
      "type": "timeseries",
      "title": "ลูกกอล์ฟ vs สิ่งแปลกปลอม (สูงสุดต่อช่วง)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-golf"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-golf"
          },
          "query": "from(bucket: \"golf\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"golf_status\" and (r._field == \"golf_count\" or r._field == \"reject_count\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "ไม่มีข้อมูล - กล้องไม่ได้รัน?",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "golf_count"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "displayName",
                "value": "ลูกกอล์ฟ"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "reject_count"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "displayName",
                "value": "สิ่งแปลกปลอม"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
