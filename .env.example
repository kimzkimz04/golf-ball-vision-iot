# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า  (ไฟล์ .env ห้ามขึ้น GitHub - อยู่ใน .gitignore แล้ว)
# ชื่อนี้ห้ามเป็น TZ: VS Code โหลด .env ตอนกด F5 และ Python บน Windows อ่าน TZ=Asia/Bangkok ผิด (เวลาช้าไป 6 ชม.)
TIMEZONE=Asia/Bangkok

# ---------- InfluxDB (ขั้นที่ 5) ----------
INFLUX_USER=admin
INFLUX_PASSWORD=change-me-please
INFLUX_ORG=golf
INFLUX_BUCKET=golf
# token ยาว ๆ อะไรก็ได้ ใช้ร่วมกันทั้ง Node-RED / Grafana / n8n
INFLUX_TOKEN=change-me-to-a-long-random-token

# ---------- Grafana (ขั้นที่ 5a) ----------
GRAFANA_PASSWORD=change-me-please

# ---------- Telegram (ขั้นที่ 4c และ 7) ----------
# สร้างบอทกับ @BotFather -> ได้ token / หา chat id จาก @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# เว้นระยะแจ้งเตือนเรื่องเดิมซ้ำ (วินาที)
ALERT_COOLDOWN_SEC=30

# ---------- Google Sheets (ขั้นที่ 4b) ----------
# URL ของ Apps Script Web App (ดู google_sheets/Code.gs)  https://script.google.com/macros/s/xxxx/exec
GSHEET_URL=
# ส่งข้อมูลเป็นชุดทุกกี่วินาที
GSHEET_BATCH_SEC=60

# ---------- AI สรุปรายงานประจำวันใน n8n (ขั้นที่ 6) ----------
# API key จาก https://platform.claude.com  (เว้นว่างได้ - n8n จะส่งสรุปแบบไม่ใช้ AI แทน)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---------- หรือใช้ Google Gemini แทน (ถ้าใส่ GEMINI_API_KEY จะใช้ Gemini ก่อน Claude) ----------
# API key จาก https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------- OpenCV container (docker compose --profile vision) ----------
# samples = รีเพลย์ภาพตัวอย่าง 28 รูป / http://host.docker.internal:8090/video = กล้องจริงผ่าน camera_stream.py
OPENCV_SOURCE=samples
OPENCV_DEVICE_ID=cam-docker
